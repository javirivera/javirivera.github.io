---
import PanelLayout from '../../layouts/PanelLayout.astro';
import { projects } from '../../lib/projects';
---
<PanelLayout title="Javier Rivera is a designer." exitHref="/">
  <div id="work-panel" class="scene_element scene_element--fadein">
    <div class="work-content col col--3-of-3">
      <h1>Work</h1>
      <div class="row">
        {
          projects.map((project) => (
            <a href={project.url}>
              <div class="work-project-tile col col--1-of-3">
                <div class="post-image-wrap">
                  <img
                    class="post-image"
                    src={project.image}
                    alt={project.description}
                  />
                </div>
                {project.tags.length > 0 && (
                  <span class=" small work-tags">
                    {project.tags.slice().sort().join(', ')}
                  </span>
                )}
                <h2 class="work-title big">{project.title}</h2>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</PanelLayout>
